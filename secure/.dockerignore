# .dockerignore excludes files from the build context.
# Benefit: faster builds, and secrets never get sent to the builder.
# https://docs.docker.com/build/concepts/context/#dockerignore-files

# Secrets and credentials (most important!)
.env
.env.*
*.pem
*.key

# Version control and IDE files
.git
.vscode
.idea
*.swp

# Docker files, logs, temp and build output
Dockerfile
.dockerignore
*.log
tmp
*.tmp
dist
build

# OS generated files
.DS_Store
Thumbs.db
